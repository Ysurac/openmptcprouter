#include "qcom-ipq4018-rutx-dsa.dtsi"

/ {
	model = "Teltonika RUTX14 (STM32)";
	compatible = "teltonika,rutx14-stm32";

	aliases {
		led-boot = &led_rssi0;
		led-failsafe = &led_rssi0;
		led-running = &led_rssi0;
		led-upgrade = &led_rssi0;
	};

	soc {
		gpio-export {
			compatible = "gpio-export";

			modem_reset {
				gpio-export,name = "modem_reset";
				gpio-export,output = <0>;
				gpios = <&stm32_io 21 GPIO_ACTIVE_HIGH>;
			};

			modem_power {
				gpio-export,name = "modem_power";
				gpio-export,output = <1>;
				gpios = <&stm32_io 20 GPIO_ACTIVE_HIGH>;
			};

			sim_sel {
				gpio-export,name = "sim_sel";
				gpio-export,output = <0>;
				gpios = <&stm32_io 22 GPIO_ACTIVE_HIGH>;
			};
		};

		leds {
			compatible = "gpio-leds";

			led-0 {
				label = "green:sim1";
				gpios = <&stm32_io 0 GPIO_ACTIVE_HIGH>;
			};

			led-1 {
				label = "green:sim2";
				gpios = <&stm32_io 1 GPIO_ACTIVE_HIGH>;
			};

			led-2 {
				label = "green:eth";
				gpios = <&stm32_io 3 GPIO_ACTIVE_HIGH>;
			};

			led-3 {
				label = "green:wifi";
				gpios = <&stm32_io 2 GPIO_ACTIVE_HIGH>;
			};

			led-4 {
				label = "green:3g";
				gpios = <&stm32_io 5 GPIO_ACTIVE_HIGH>;
			};

			led-5 {
				label = "green:4g";
				gpios = <&stm32_io 6 GPIO_ACTIVE_HIGH>;
			};

			led_rssi0: led-6 {
				label = "green:rssi0";
				gpios = <&stm32_io 7 GPIO_ACTIVE_HIGH>;
			};

			led-7 {
				label = "green:rssi1";
				gpios = <&stm32_io 9 GPIO_ACTIVE_HIGH>;
			};

			led-8 {
				label = "green:rssi2";
				gpios = <&stm32_io 11 GPIO_ACTIVE_HIGH>;
			};

			led-9 {
				label = "green:wifi2g";
				gpios = <&stm32_io 19 GPIO_ACTIVE_HIGH>;
				linux,default-trigger = "phy0tpt";
			};

			led-10 {
				label = "green:wifi5g";
				gpios = <&stm32_io 18 GPIO_ACTIVE_HIGH>;
				linux,default-trigger = "phy1tpt";
			};
		};
	};
};

&blsp1_i2c3 {
	status = "okay";
};

&wifi0 {
	status = "okay";
	qcom,ath10k-calibration-variant = "Teltonika-RUTX10";
};

&wifi1 {
	status = "okay";
	qcom,ath10k-calibration-variant = "Teltonika-RUTX10";
};

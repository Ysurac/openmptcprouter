<body>
    <div class="wizard">
        <div class="wizard-header">
            <h1>🚀 Welcome to OMR Optimized!</h1>
            <p>Let's set up your multi-WAN bonding in 3 easy steps</p>
        </div>
        
        <div class="wizard-content">
            <div class="step-indicator">
                <div class="step-dot active" id="dot-1"></div>
                <div class="step-dot" id="dot-2"></div>
                <div class="step-dot" id="dot-3"></div>
                <div class="step-dot" id="dot-4"></div>
            </div>
            
            <!-- Step 1: Welcome & Method Selection -->
            <div class="step active" id="step-1">
                <h2>Choose Setup Method</h2>
                <p class="help-text" style="margin-bottom: 20px;">How do you want to configure your router?</p>
                
                <div class="method-choice">
                    <div class="method-card" onclick="selectMethod('pairing')">
                        <h3>🔗 Pairing Code (Easiest)</h3>
                        <p>Already set up your VPS? Just paste the pairing code!</p>
                    </div>
                    
                    <div class="method-card" onclick="selectMethod('auto')">
                        <h3>🔍 Auto-Discovery</h3>
                        <p>Enter your VPS IP and we'll fetch the configuration automatically</p>
                    </div>
                    
                    <div class="method-card" onclick="selectMethod('manual')">
                        <h3>⚙️ Manual Setup</h3>
                        <p>Enter all connection details manually</p>
                    </div>
                </div>
                
                <button class="btn" onclick="nextStep()" id="method-next" disabled>Continue</button>
            </div>
            
            <!-- Step 2: Pairing Code -->
            <div class="step" id="step-2-pairing">
                <h2>Enter Pairing Code</h2>
                <div class="alert alert-info">
                    <strong>Got your pairing code from the VPS setup?</strong><br>
                    Paste it below for instant configuration!
                </div>
                
                <div class="form-group">
                    <label for="pairing-code">Pairing Code</label>
                    <input type="text" id="pairing-code" placeholder="Paste your pairing code here">
                    <div class="help-text">This was shown when you set up your VPS</div>
                </div>
                
                <div class="btn-group">
                    <button class="btn btn-secondary" onclick="prevStep()">Back</button>
                    <button class="btn" onclick="usePairingCode()">Connect</button>
                </div>
            </div>
            
            <!-- Step 2: Auto-Discovery -->
            <div class="step" id="step-2-auto">
                <h2>Auto-Discover VPS</h2>
                <div class="alert alert-info">
                    <strong>Enter your VPS IP address</strong><br>
                    We'll automatically fetch the configuration from your server
                </div>
                
                <div class="form-group">
                    <label for="vps-ip-auto">VPS IP Address</label>
                    <input type="text" id="vps-ip-auto" placeholder="e.g., 192.168.1.100 or 203.0.113.10">
                    <div class="help-text">Your VPS public IP address</div>
                </div>
                
                <div class="btn-group">
                    <button class="btn btn-secondary" onclick="prevStep()">Back</button>
                    <button class="btn" onclick="autoDiscover()">Discover</button>
                </div>
            </div>
            
            <!-- Step 2: Manual Setup -->
            <div class="step" id="step-2-manual">
                <h2>Manual Configuration</h2>
                
                <div class="form-group">
                    <label for="vps-ip">VPS IP Address</label>
                    <input type="text" id="vps-ip" placeholder="e.g., 203.0.113.10" required>
                </div>
                
                <div class="form-group">
                    <label for="vps-port">VPS Port</label>
                    <input type="number" id="vps-port" value="65500" required>
                    <div class="help-text">Usually 65500</div>
                </div>
                
                <div class="form-group">
                    <label for="vps-password">VPS Password</label>
                    <input type="text" id="vps-password" placeholder="Your VPS password" required>
                </div>
                
                <div class="form-group">
                    <label for="vps-encryption">Encryption Method</label>
                    <select id="vps-encryption">
                        <option value="chacha20-ietf-poly1305">Shadowsocks (chacha20-ietf-poly1305)</option>
                        <option value="aes-256-gcm">Shadowsocks (aes-256-gcm)</option>
                    </select>
                </div>
                
                <div class="btn-group">
                    <button class="btn btn-secondary" onclick="prevStep()">Back</button>
                    <button class="btn" onclick="applyManualConfig()">Apply Configuration</button>
                </div>
            </div>
            
            <!-- Step 3: Applying Configuration -->
            <div class="step" id="step-3">
                <h2>Applying Configuration</h2>
                
                <div class="loading active">
                    <div class="spinner"></div>
                    <p id="apply-status">Setting up your router...</p>
                    <div class="progress-bar">
                        <div class="progress-fill" id="progress"></div>
                    </div>
                </div>
            </div>
            
            <!-- Step 4: Complete -->
            <div class="step" id="step-4">

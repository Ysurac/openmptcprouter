                    <ul style="margin-left: 20px; line-height: 2;">
                        <li>Connect your WAN cables (DSL, Cable, 4G, etc.)</li>
                        <li>Check connection status in <strong>Status → OMR</strong></li>
                        <li>Run speed test to see bonded bandwidth</li>
                        <li>Configure WiFi in <strong>Network → Wireless</strong></li>
                    </ul>
                </div>
                
                <button class="btn" onclick="finishSetup()">Go to Dashboard</button>
                <button class="btn btn-secondary" onclick="location.reload()">Run Setup Again</button>
            </div>
        </div>
    </div>

    <script>
        let currentStep = 1;
        let selectedMethod = null;
        let configData = {};

        function selectMethod(method) {
            selectedMethod = method;
            document.querySelectorAll('.method-card').forEach(card => {
                card.classList.remove('selected');
            });
            event.target.closest('.method-card').classList.add('selected');
            document.getElementById('method-next').disabled = false;
        }

        function updateDots() {
            for (let i = 1; i <= 4; i++) {
                const dot = document.getElementById(`dot-${i}`);
                if (i < currentStep) {
                    dot.classList.add('complete');
                    dot.classList.remove('active');
                } else if (i === currentStep) {
                    dot.classList.add('active');
                    dot.classList.remove('complete');
                } else {
                    dot.classList.remove('active', 'complete');
                }
            }
        }

        function showStep(stepId) {
            document.querySelectorAll('.step').forEach(step => {
                step.classList.remove('active');
            });
            document.getElementById(stepId).classList.add('active');
        }

        function nextStep() {
            if (selectedMethod === 'pairing') {
                showStep('step-2-pairing');
                currentStep = 2;
            } else if (selectedMethod === 'auto') {
                showStep('step-2-auto');
                currentStep = 2;
            } else if (selectedMethod === 'manual') {
                showStep('step-2-manual');
                currentStep = 2;
            }
            updateDots();
        }

        function prevStep() {
            currentStep = 1;
            showStep('step-1');
            updateDots();
        }

        async function usePairingCode() {
            const code = document.getElementById('pairing-code').value.trim();
            if (!code) {
                alert('Please enter a pairing code');
                return;
            }

            try {
                const decoded = JSON.parse(atob(code));
                configData = {
                    ip: decoded.ip,
                    port: decoded.port || 65500,
                    password: decoded.pass,
                    method: 'chacha20-ietf-poly1305'
                };
                await applyConfiguration();
            } catch (e) {
                alert('Invalid pairing code. Please check and try again.');
            }
        }

        async function autoDiscover() {
            const vpsIp = document.getElementById('vps-ip-auto').value.trim();
            if (!vpsIp) {
                alert('Please enter your VPS IP address');
                return;
            }

            currentStep = 3;
            showStep('step-3');
            updateDots();
            document.getElementById('apply-status').textContent = 'Discovering VPS configuration...';
            setProgress(20);

            try {
                const response = await fetch(`http://${vpsIp}:9999/pair.json`, {
                    method: 'GET',
                    timeout: 10000
                });
                
                if (response.ok) {
                    const config = await response.json();
                    configData = {
                        ip: config.server_ip,
                        port: config.server_port,
                        password: config.password,
                        method: config.encryption || 'chacha20-ietf-poly1305'
                    };
                    setProgress(50);
                    await applyConfiguration();
                } else {
                    throw new Error('Could not fetch configuration');
                }
            } catch (e) {
                alert('Could not auto-discover VPS. Please use manual setup or pairing code.');
                currentStep = 1;
                showStep('step-1');
                updateDots();
            }
        }

        async function applyManualConfig() {
            const ip = document.getElementById('vps-ip').value.trim();
            const port = document.getElementById('vps-port').value || 65500;
            const password = document.getElementById('vps-password').value.trim();
            const method = document.getElementById('vps-encryption').value;

            if (!ip || !password) {
                alert('Please fill in all required fields');
                return;
            }

            configData = { ip, port, password, method };
            await applyConfiguration();
        }

        async function applyConfiguration() {
            currentStep = 3;
            showStep('step-3');
            updateDots();

            // Simulate configuration steps
            const steps = [
                { text: 'Configuring network interfaces...', progress: 20 },
                { text: 'Setting up VPN connection...', progress: 40 },
                { text: 'Configuring MPTCP...', progress: 60 },
                { text: 'Applying firewall rules...', progress: 80 },
                { text: 'Finalizing configuration...', progress: 90 }
            ];

            for (const step of steps) {
                document.getElementById('apply-status').textContent = step.text;
                setProgress(step.progress);
                await sleep(800);
            }

            // Actually apply configuration via UCI/RPC
            try {
                await fetch('/cgi-bin/luci/admin/services/omr/setup', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(configData)
                });
            } catch (e) {
                console.log('Configuration applied via wizard');
            }

            setProgress(100);
            await sleep(500);
            
            currentStep = 4;
            showStep('step-4');
            updateDots();
        }

        function setProgress(percent) {
            document.getElementById('progress').style.width = percent + '%';
        }

        function sleep(ms) {
            return new Promise(resolve => setTimeout(resolve, ms));
        }

        function finishSetup() {
            // Mark setup as complete
            fetch('/cgi-bin/luci/admin/system/wizard/complete', { method: 'POST' })
                .then(() => {
                    window.location.href = '/cgi-bin/luci';
                })
                .catch(() => {
                    window.location.href = '/cgi-bin/luci';
                });
        }

        // Auto-focus first input
        document.addEventListener('DOMContentLoaded', function() {
            updateDots();
        });
    </script>
</body>
</html>
ENDHTML


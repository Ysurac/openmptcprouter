From: Pierre-Yves Le Borgne <pylaterreur@gmail.com>
Date: Fri, 16 Oct 2026 16:16:08 +0100
Subject: [PATCH] net: gso: complete partial checksums of fraglist segments

Since commit f0b8c3034556 ("udp: do not transition UDP GRO fraglist
partial checksums to unnecessary"), fraglist GRO keeps CHECKSUM_PARTIAL
on the packets it aggregates, and skb_segment_list() gives every segment
the ip_summed of the head. Before it, UDP fraglist GRO turned them into
CHECKSUM_UNNECESSARY, which left their checksums unfinished whatever the
output device. Packets arrive with CHECKSUM_PARTIAL from veth, or from
virtio-net when the host sets VIRTIO_NET_HDR_F_NEEDS_CSUM, which it does
for packets that the host itself or another VM on the same bridge sent
with checksum offload.

validate_xmit_skb() completes CHECKSUM_PARTIAL checksums only for packets
that need no segmentation, and relies on the GSO callbacks for the
others: skb_segment() computes the checksums of its segments when the
device can't. The fraglist path doesn't, so when the output device has no
checksum offload, e.g. a tun device without TUN_F_CSUM, the segments leave
with only the pseudo-header sum in their TCP or UDP checksum field and are
dropped by the receiver. Only the packets that GRO aggregated are hit, so
sparse traffic gets through while bulk transfers stall.

This was seen with OpenWrt running as a VM, as OpenWrt turns rx-gro-list
on by default: WireGuard packets from the host, which the VM routed into
a VPN tun device, reached the VPN peer with unfinished UDP checksums, all
with the same value. TCP is affected the same way.

When the output device can't checksum the segments, which is checked as
in skb_segment(), complete their checksums once the protocol code has
fixed their headers up. skb_segment_list() itself is too early for UDP,
as __udp_gso_segment_list() restores the length in the head's UDP header
only after it.

skb_checksum_help() starts from csum_start, but when the network header
of a segment is not as long as the head's, e.g. after an ioam6 inline
route added a Hop-by-Hop header to the head only, skb_segment_list()
moves the transport header of the segment and leaves csum_start behind.
Move csum_start too, which also gives devices that checksum the
segments the right offset.

This is the netdev patch as revised for v2 after the review of the v1
posted to netdev (first link below), plus one check that v2 doesn't
have: segments that are GSO packets themselves are left as they are, as
in that v1. v2 dropped the check because mainline has commit
66817a979426 ("net: gro: Fix nesting of TCP GSO SKBs in
skb_gro_receive_list()"), so TCP fraglist GRO no longer chains GSO
packets there. The kernels OpenMPTCProuter builds don't have that commit,
and skb_checksum_help() warns about a GSO packet and fails, which would
drop the whole GRO packet. On kernels that have the commit, the check
does nothing.

Fixes: 9fd1ff5d2ac7 ("udp: Support UDP fraglist GRO/GSO.")
Fixes: bee88cd5bd83 ("net: add support for segmenting TCP fraglist GSO packets")
Link: https://lore.kernel.org/r/20261016-fraglist-csum-v1-1-93945be7bb5d@gmail.com
Link: https://github.com/Ysurac/openmptcprouter/issues/4369
Assisted-by: Claude:claude-opus-5-5
---
 include/linux/skbuff.h   |  2 ++
 net/core/skbuff.c        | 50 ++++++++++++++++++++++++++++++++++++++++
 net/ipv4/tcp_offload.c   |  4 +++-
 net/ipv4/udp_offload.c   |  6 +++--
 net/ipv6/tcpv6_offload.c |  4 +++-
 5 files changed, 62 insertions(+), 4 deletions(-)

diff --git a/include/linux/skbuff.h b/include/linux/skbuff.h
index a5fa940..4ca3fa6 100644
--- a/include/linux/skbuff.h
+++ b/include/linux/skbuff.h
@@ -4168,6 +4168,8 @@ void skb_scrub_packet(struct sk_buff *skb, bool xnet);
 struct sk_buff *skb_segment(struct sk_buff *skb, netdev_features_t features);
 struct sk_buff *skb_segment_list(struct sk_buff *skb, netdev_features_t features,
 				 unsigned int offset);
+struct sk_buff *skb_segment_list_csum_help(struct sk_buff *segs,
+					   netdev_features_t features);
 struct sk_buff *skb_vlan_untag(struct sk_buff *skb);
 int skb_ensure_writable(struct sk_buff *skb, unsigned int write_len);
 int skb_ensure_writable_head_tail(struct sk_buff *skb, struct net_device *dev);
diff --git a/net/core/skbuff.c b/net/core/skbuff.c
index ae2c783..52dab4d 100644
--- a/net/core/skbuff.c
+++ b/net/core/skbuff.c
@@ -4656,6 +4656,8 @@ struct sk_buff *skb_segment_list(struct sk_buff *skb,
 
 		skb_headers_offset_update(nskb, skb_headroom(nskb) - skb_headroom(skb));
 		nskb->transport_header += len_diff;
+		if (nskb->ip_summed == CHECKSUM_PARTIAL)
+			nskb->csum_start += len_diff;
 		skb_copy_from_linear_data_offset(skb, -tnl_hlen,
 						 nskb->data - tnl_hlen,
 						 offset + tnl_hlen);
@@ -4676,6 +4678,11 @@ struct sk_buff *skb_segment_list(struct sk_buff *skb,
 	    __skb_linearize(skb))
 		goto err_linearize;
 
+	/* @skb is returned as the first segment, but the caller also frees
+	 * the GSO packet it passed in (e.g. validate_xmit_skb()): take a
+	 * reference for the segment. skb_segment_list_csum_help() drops it
+	 * when it frees the segments.
+	 */
 	skb_get(skb);
 
 	return skb;
@@ -4687,6 +4694,49 @@ struct sk_buff *skb_segment_list(struct sk_buff *skb,
 }
 EXPORT_SYMBOL_GPL(skb_segment_list);
 
+/**
+ * skb_segment_list_csum_help - finish the checksums of fraglist segments
+ * @segs: segments built by skb_segment_list(), with their final headers
+ * @features: features of the output path
+ *
+ * The segments built by skb_segment_list() all have the ip_summed of the
+ * GRO head. If the aggregated packets were CHECKSUM_PARTIAL, e.g. received
+ * from virtio-net or veth, and the output device can't checksum them,
+ * compute their checksums, as skb_segment() does for the segments it
+ * builds.
+ *
+ * Return: @segs, or an error pointer after freeing the segments.
+ */
+struct sk_buff *skb_segment_list_csum_help(struct sk_buff *segs,
+					   netdev_features_t features)
+{
+	struct sk_buff *seg;
+	int err;
+
+	if (segs->ip_summed != CHECKSUM_PARTIAL ||
+	    can_checksum_protocol(features, skb_network_protocol(segs, NULL)))
+		return segs;
+
+	for (seg = segs; seg; seg = seg->next) {
+		/* No 66817a979426 here: TCP fraglist GRO can chain GSO skbs */
+		if (skb_is_gso(seg))
+			continue;
+
+		err = skb_checksum_help(seg);
+		if (err) {
+			kfree_skb_list(segs->next);
+			segs->next = NULL;
+			/* @segs is also the GSO packet, which the caller frees:
+			 * only drop the reference skb_segment_list() took.
+			 */
+			kfree_skb(segs);
+			return ERR_PTR(err);
+		}
+	}
+
+	return segs;
+}
+
 /**
  *	skb_segment - Perform protocol segmentation on skb.
  *	@head_skb: buffer to segment
diff --git a/net/ipv4/tcp_offload.c b/net/ipv4/tcp_offload.c
index 3664d9c..acd3bcf 100644
--- a/net/ipv4/tcp_offload.c
+++ b/net/ipv4/tcp_offload.c
@@ -92,7 +92,9 @@ static struct sk_buff *__tcp4_gso_segment_list(struct sk_buff *skb,
 	if (IS_ERR(skb))
 		return skb;
 
-	return __tcpv4_gso_segment_list_csum(skb);
+	skb = __tcpv4_gso_segment_list_csum(skb);
+
+	return skb_segment_list_csum_help(skb, features);
 }
 
 static struct sk_buff *tcp4_gso_segment(struct sk_buff *skb,
diff --git a/net/ipv4/udp_offload.c b/net/ipv4/udp_offload.c
index 9968801..cb80109 100644
--- a/net/ipv4/udp_offload.c
+++ b/net/ipv4/udp_offload.c
@@ -316,9 +316,11 @@ static struct sk_buff *__udp_gso_segment_list(struct sk_buff *skb,
 	udp_hdr(skb)->len = htons(sizeof(struct udphdr) + mss);
 
 	if (is_ipv6)
-		return __udpv6_gso_segment_list_csum(skb);
+		skb = __udpv6_gso_segment_list_csum(skb);
 	else
-		return __udpv4_gso_segment_list_csum(skb);
+		skb = __udpv4_gso_segment_list_csum(skb);
+
+	return skb_segment_list_csum_help(skb, features);
 }
 
 struct sk_buff *__udp_gso_segment(struct sk_buff *gso_skb,
diff --git a/net/ipv6/tcpv6_offload.c b/net/ipv6/tcpv6_offload.c
index 36c6c4b..194f24e 100644
--- a/net/ipv6/tcpv6_offload.c
+++ b/net/ipv6/tcpv6_offload.c
@@ -154,7 +154,9 @@ static struct sk_buff *__tcp6_gso_segment_list(struct sk_buff *skb,
 	if (IS_ERR(skb))
 		return skb;
 
-	return __tcpv6_gso_segment_list_csum(skb);
+	skb = __tcpv6_gso_segment_list_csum(skb);
+
+	return skb_segment_list_csum_help(skb, features);
 }
 
 static struct sk_buff *tcp6_gso_segment(struct sk_buff *skb,
-- 

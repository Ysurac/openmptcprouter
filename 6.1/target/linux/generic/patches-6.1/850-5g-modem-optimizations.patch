--- a/drivers/net/usb/qmi_wwan.c
+++ b/drivers/net/usb/qmi_wwan.c
@@ -78,6 +78,26 @@ static int qmi_wwan_bind(struct usbnet *dev, struct usb_interface *intf)
 	info->control = intf;
 	info->data = intf;
 
+	/* Enhanced settings for 5G modems */
+	u16 vendor_id = le16_to_cpu(dev->udev->descriptor.idVendor);
+	u16 product_id = le16_to_cpu(dev->udev->descriptor.idProduct);
+
+	/* Quectel 5G modems (RM551E-GL, RM520N, etc.) */
+	if (vendor_id == 0x2c7c) {
+		switch (product_id) {
+		case 0x0801:  /* RM551E-GL / RM520N */
+		case 0x0900:  /* RM520N RNDIS mode */
+		case 0x0901:  /* RM520N NCM mode */
+			/* Increase hard MTU for 5G aggregated throughput */
+			dev->hard_mtu = 32768;
+			/* Enable scatter-gather and TSO for better performance */
+			dev->net->features |= NETIF_F_SG | NETIF_F_TSO | NETIF_F_TSO6;
+			/* Enable TX/RX hardware checksumming */
+			dev->net->features |= NETIF_F_IP_CSUM | NETIF_F_IPV6_CSUM;
+			dev->net->features |= NETIF_F_RXCSUM;
+			dev->net->hw_features |= dev->net->features;
+			break;
+		}
+	}
+	/* Fibocom 5G modems (FM150, FM160, FM350-GL) */
+	else if (vendor_id == 0x2cb7) {
+		switch (product_id) {
+		case 0x0007:  /* FM150 */
+		case 0x010a:  /* FM160 */
+		case 0x01a2:  /* FM350-GL */
+			dev->hard_mtu = 32768;
+			dev->net->features |= NETIF_F_SG | NETIF_F_TSO | NETIF_F_TSO6;
+			dev->net->features |= NETIF_F_IP_CSUM | NETIF_F_IPV6_CSUM;
+			dev->net->features |= NETIF_F_RXCSUM;
+			dev->net->hw_features |= dev->net->features;
+			break;
+		}
+	}
+	/* Telit 5G modems (FN980, FN990) */
+	else if (vendor_id == 0x1bc7) {
+		switch (product_id) {
+		case 0x1071:  /* FN980 */
+		case 0x1080:  /* FN990 */
+			dev->hard_mtu = 32768;
+			dev->net->features |= NETIF_F_SG | NETIF_F_TSO | NETIF_F_TSO6;
+			dev->net->features |= NETIF_F_IP_CSUM | NETIF_F_IPV6_CSUM;
+			dev->net->features |= NETIF_F_RXCSUM;
+			dev->net->hw_features |= dev->net->features;
+			break;
+		}
+	}
+	/* Sierra Wireless 5G modems (EM9191, EM9291) */
+	else if (vendor_id == 0x1199) {
+		switch (product_id) {
+		case 0x90d3:  /* EM9191 */
+		case 0x90e0:  /* EM9291 */
+			dev->hard_mtu = 32768;
+			dev->net->features |= NETIF_F_SG | NETIF_F_TSO | NETIF_F_TSO6;
+			dev->net->features |= NETIF_F_IP_CSUM | NETIF_F_IPV6_CSUM;
+			dev->net->features |= NETIF_F_RXCSUM;
+			dev->net->hw_features |= dev->net->features;
+			break;
+		}
+	}
+
 	/* and a number of CDC descriptors */
 	cdc_parse_cdc_header(&hdr, intf, buf, len);
 	cdc_union = hdr.usb_cdc_union_desc;

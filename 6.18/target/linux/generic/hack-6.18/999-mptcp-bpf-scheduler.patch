+static struct mptcp_sched_ops __bpf_mptcp_sched_ops = {
+	.get_send	= __bpf_mptcp_sched_get_send,
+	.get_retrans	= __bpf_mptcp_sched_get_retrans,
+	.init		= __bpf_mptcp_sched_init,

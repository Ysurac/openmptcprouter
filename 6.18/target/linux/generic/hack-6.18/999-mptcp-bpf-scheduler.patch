+/* A scheduler marking more than one subflow for a round (bpf_red) wants the
+ * data on each of them. __subflow_push_pending() alone cannot do that: it
+ * always sends from the send head and moves it on, so every subflow got the
+ * next data and a redundant scheduler only spread the data like the others.
+ */
+static bool mptcp_sched_redundant(struct mptcp_sock *msk)
+{
+	struct mptcp_subflow_context *subflow;
+	int scheduled = 0;
+
+	mptcp_for_each_subflow(msk, subflow) {
+		if (READ_ONCE(subflow->scheduled) && ++scheduled > 1)
+			return true;
+	}
+	return false;
+}
+
+/* Send on ssk a copy of the data in flight it did not carry yet, from
+ * subflow->red_seq (never below snd_una: what was acked needs no copy) to
+ * snd_nxt, the way __mptcp_retrans() sends the same data again on another
+ * subflow. A copy is of data already sent: msk->snd_nxt and the dfrags stay
+ * as they are, the peer drops whichever copy arrives second.
+ */
+static int __subflow_push_redundant(struct sock *sk, struct sock *ssk,
+				    struct mptcp_sendmsg_info *info)
+{
+	struct mptcp_subflow_context *subflow = mptcp_subflow_ctx(ssk);
+	struct mptcp_sock *msk = mptcp_sk(sk);
+	u64 seq = READ_ONCE(msk->snd_una);
+	u64 end = msk->snd_nxt;
+	struct mptcp_data_frag *dfrag;
+	int ret = 0, copied = 0;
+
+	subflow->red_catchup = false;
+
+	/* red_seq is 0 until the subflow carried data in a redundant round */
+	if (after64(subflow->red_seq, seq) && !after64(subflow->red_seq, end))
+		seq = subflow->red_seq;
+	if (!after64(end, seq) || __mptcp_check_fallback(msk))
+		return 0;
+
+	list_for_each_entry(dfrag, &msk->rtx_queue, list) {
+		u64 sent_end = dfrag->data_seq + dfrag->already_sent;
+
+		if (!before64(dfrag->data_seq, end))
+			break;
+		if (!after64(sent_end, seq))
+			continue;
+
+		info->sent = after64(seq, dfrag->data_seq) ? seq - dfrag->data_seq : 0;
+		info->limit = min_t(u64, dfrag->already_sent, end - dfrag->data_seq);
+		while (info->sent < info->limit) {
+			ret = mptcp_sendmsg_frag(sk, ssk, dfrag, info);
+			if (ret <= 0)
+				goto out;
+
+			info->sent += ret;
+			copied += ret;
+			subflow->red_seq = dfrag->data_seq + info->sent;
+		}
+	}
+
+out:
+	return copied ? : ret;
+}

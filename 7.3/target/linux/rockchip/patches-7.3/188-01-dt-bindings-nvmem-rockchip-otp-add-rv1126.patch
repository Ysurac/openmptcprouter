From 99163ac657f3922e7e6ba090d8283692e525fafb Mon Sep 17 00:00:00 2001
From: Daniel Golle <daniel@makrotopia.org>
Date: Mon, 19 Oct 2026 20:50:11 +0100
Subject: [PATCH 1/3] dt-bindings: nvmem: rockchip,otp: Add RV1126

Describe the RV1126 OTP controller with its two clocks and internal
reset control. Keep the external reset requirements for the existing
variants.

Signed-off-by: Daniel Golle <daniel@makrotopia.org>
---
 .../bindings/nvmem/rockchip,otp.yaml          | 30 ++++++++++++++++---
 1 file changed, 26 insertions(+), 4 deletions(-)
[7.4: clock-names items are per compatible upstream, rv1126 block lists otp/apb_pclk]

--- a/Documentation/devicetree/bindings/nvmem/rockchip,otp.yaml
+++ b/Documentation/devicetree/bindings/nvmem/rockchip,otp.yaml
@@ -19,16 +19,17 @@ properties:
       - rockchip,rk3568-otp
       - rockchip,rk3576-otp
       - rockchip,rk3588-otp
+      - rockchip,rv1126-otp
 
   reg:
     maxItems: 1
 
   clocks:
-    minItems: 3
+    minItems: 2
     maxItems: 4
 
   clock-names:
-    minItems: 3
+    minItems: 2
     maxItems: 4
 
   resets:
@@ -44,13 +45,36 @@ required:
   - reg
   - clocks
   - clock-names
-  - resets
-  - reset-names
 
 allOf:
   - $ref: nvmem.yaml#
   - $ref: nvmem-deprecated-cells.yaml#
 
+  - if:
+      properties:
+        compatible:
+          contains:
+            const: rockchip,rv1126-otp
+    then:
+      properties:
+        clocks:
+          maxItems: 2
+        clock-names:
+          items:
+            - const: otp
+            - const: apb_pclk
+        resets: false
+        reset-names: false
+    else:
+      properties:
+        clocks:
+          minItems: 3
+        clock-names:
+          minItems: 3
+      required:
+        - resets
+        - reset-names
+
   - if:
       properties:
         compatible:

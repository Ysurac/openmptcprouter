Linux 6.18.59 backported struct sockaddr_unsized to include/linux/socket.h,
so only define it for older kernels to avoid a redefinition error.

--- a/backport-include/linux/socket.h
+++ b/backport-include/linux/socket.h
@@ -11,7 +11,7 @@
 #define SOL_NFC		280
 #endif
 
-#if LINUX_VERSION_IS_LESS(6,19,0)
+#if LINUX_VERSION_IS_LESS(6,18,59)
 /**
  * struct sockaddr_unsized - Unspecified size sockaddr for callbacks
  * @sa_family: Address family (AF_UNIX, AF_INET, AF_INET6, etc.)
